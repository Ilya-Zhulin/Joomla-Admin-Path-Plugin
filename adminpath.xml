<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_adminpath</name>
    <author>Ilya A. Zhulin</author>
    <creationDate>2026-02-11</creationDate>
    <copyright>Copyright (C) 2026 Bolashaq.me</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>ilya.zhulin@hotmail.com</authorEmail>
    <authorUrl>https://bolashaq.me</authorUrl>
    <version>1.0.0</version>
    <description>PLG_SYSTEM_ADMINPATH_XML_DESCRIPTION</description>

    <namespace path="src">Joomla\Plugin\System\AdminPath</namespace>

    <files>
        <folder>services</folder>
        <folder>src</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.plg_system_adminpath.ini</language>
        <language tag="ru-RU">ru-RU/ru-RU.plg_system_adminpath.ini</language>
        <language tag="kk-KZ">kk-KZ/kk-KZ.plg_system_adminpath.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="secret_path" type="text" default="admin-bolashaq-2026"
                       label="PLG_SYSTEM_ADMINPATH_SECRET_PATH_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_SECRET_PATH_DESC" filter="cmd"/>
                <field name="block_direct" type="radio" default="1" label="PLG_SYSTEM_ADMINPATH_BLOCK_DIRECT_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_BLOCK_DIRECT_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
