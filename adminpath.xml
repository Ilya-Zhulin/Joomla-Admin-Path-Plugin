<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_adminpath</name>
    <author>Ilya A. Zhulin</author>
    <creationDate>12.02.2026</creationDate>
    <copyright>Copyright (C) 2026 Bolashaq.me</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>ilya.zhulin@hotmail.com</authorEmail>
    <authorUrl>https://zhulinia.ru</authorUrl>
    <version>1.1.0</version>
    <description>PLG_SYSTEM_ADMINPATH_XML_DESCRIPTION</description>

    <namespace path="src">Joomla\Plugin\System\AdminPath</namespace>

    <files>
        <folder plugin="adminpath">src</folder>
        <folder>services</folder>
        <filename>script.php</filename>
        <filename>adminpath.xml</filename>
    </files>

    <media destination="plg_system_adminpath" folder="media">
        <folder>js</folder>
    </media>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_adminpath.ini</language>
        <language tag="en-GB">en-GB/plg_system_adminpath.sys.ini</language>
        <language tag="ru-RU">ru-RU/plg_system_adminpath.ini</language>
        <language tag="ru-RU">ru-RU/plg_system_adminpath.sys.ini</language>
        <language tag="kk-KZ">kk-KZ/plg_system_adminpath.ini</language>
        <language tag="kk-KZ">kk-KZ/plg_system_adminpath.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field required="1" name="secret_path" type="text" default="secretadmin"
                       label="PLG_SYSTEM_ADMINPATH_SECRET_PATH_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_SECRET_PATH_DESC" filter="cmd"/>
                <field name="admin_url_display" type="note" class="alert alert-info admin_url_display" label="Dfi ehk"
                       description="PLG_SYSTEM_ADMINPATH_ADMIN_URL_DISPLAY_DESC"/>
                <field name="block_direct" type="radio" default="0" label="PLG_SYSTEM_ADMINPATH_BLOCK_DIRECT_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_BLOCK_DIRECT_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="redirect_type" type="list" default="404" label="PLG_SYSTEM_ADMINPATH_REDIRECT_TYPE_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_REDIRECT_TYPE_DESC">
                    <option value="404">PLG_SYSTEM_ADMINPATH_REDIRECT_404</option>
                    <option value="home">PLG_SYSTEM_ADMINPATH_REDIRECT_HOME</option>
                    <option value="custom">PLG_SYSTEM_ADMINPATH_REDIRECT_CUSTOM</option>
                </field>

                <field name="custom_redirect_url" type="url" default=""
                       label="PLG_SYSTEM_ADMINPATH_CUSTOM_REDIRECT_URL_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_CUSTOM_REDIRECT_URL_DESC" showon="redirect_type:custom"
                       filter="url"/>
                <field name="allowed_ips" type="textarea" default="" rows="4" cols="40"
                       label="PLG_SYSTEM_ADMINPATH_ALLOWED_IPS_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_ALLOWED_IPS_DESC"
                       filter="raw"/>
                <field name="ip_prompt" type="radio" default="0" label="PLG_SYSTEM_ADMINPATH_IP_PROMPT_LABEL"
                       description="PLG_SYSTEM_ADMINPATH_IP_PROMPT_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
    <scriptfile>script.php</scriptfile>
</extension>
